@echo off
REM 复制为 env.bat 并填入真实 key（env.bat 已 gitignore，不会进仓库）
REM 检索侧三件（embedding-3 / rerank / glm-4v）固定智谱：
set ANTHROPIC_API_KEY=你的智谱key

REM 可选：生成切 DeepSeek（实测快 4 倍、评测持平）——不设则默认智谱 glm-5.3
REM set CHAT_API_KEY=你的deepseekkey
REM set ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
REM set ANTHROPIC_CHAT_MODEL=deepseek-flash

REM 可选：钉钉机器人（Stream 模式，免公网）
REM set DINGTALK_CLIENT_ID=xxx
REM set DINGTALK_CLIENT_SECRET=xxx

REM 可选：限流与预算（默认 50 问/人/天、500k token/天）
REM set DAILY_QUESTION_LIMIT=50
REM set DAILY_TOKEN_BUDGET=500000
