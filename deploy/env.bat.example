@echo off
REM Copy this file to env.bat and fill in real keys (env.bat is gitignored).
REM NOTE: keep this file ASCII-only. UTF-8 Chinese comments break cmd batch
REM parsing (a comment line can eat the following newline and split a set
REM line in two) - don't put Chinese text back in here.
REM Retrieval side (embedding-3 / rerank / glm-4v) fixed on Zhipu:
set ANTHROPIC_API_KEY=你的智谱key

REM Generation fixed on DeepSeek (4x faster, eval on par):
set CHAT_API_KEY=你的deepseekkey
set ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
set ANTHROPIC_CHAT_MODEL=deepseek-flash

REM Optional: DingTalk bot (Stream mode, no public IP needed)
REM set DINGTALK_CLIENT_ID=xxx
REM set DINGTALK_CLIENT_SECRET=xxx

REM Optional: rate limits (default 50 questions/person/day, 500k tokens/day)
REM set DAILY_QUESTION_LIMIT=50
REM set DAILY_TOKEN_BUDGET=500000
